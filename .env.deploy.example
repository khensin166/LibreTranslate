# ==========================================
# LibreTranslate VPS Deployment Configuration
# ==========================================

# Port exposed on the host VPS (default: 5000)
LIBRETRANSLATE_PORT=5000

# Docker image built via GitHub Actions GHCR
IMAGE_NAME=ghcr.io/khensin166/libretranslate:latest

# Languages loaded into memory (restricted to Indonesian & English to minimize RAM)
LT_LOAD_ONLY=id,en
LT_UPDATE_MODELS=true

# Resource optimization
LT_THREADS=2
LT_CHAR_LIMIT=5000
LT_REQ_LIMIT=120
LT_BATCH_LIMIT=20

